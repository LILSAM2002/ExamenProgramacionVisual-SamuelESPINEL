<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.simposons.personajes.PersonajeController">
    <top>
        <VBox spacing="10" style="-fx-padding: 15;">
            <Label text="Búsqueda de Personajes Simpsons" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <TextField fx:id="searchField" promptText="Ingresa el nombre del personaje" HBox.hgrow="ALWAYS"/>
                <Button fx:id="searchButton" text="Buscar" style="-fx-padding: 8 20;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="15" style="-fx-padding: 15;">
            <ListView fx:id="personajesList" prefWidth="250" HBox.hgrow="NEVER"/>
            
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label fx:id="nombreLabel" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                <ImageView fx:id="fotoImageView" fitWidth="200" fitHeight="300" preserveRatio="true"/>
                <Label text="Ocupación:" style="-fx-font-weight: bold;"/>
                <Label fx:id="ocupacionLabel" wrapText="true"/>
                <Label text="Cita Famosa:" style="-fx-font-weight: bold;"/>
                <Label fx:id="citaLabel" wrapText="true"/>
                <Label text="Detalles:" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="detallesArea" wrapText="true" prefRowCount="5" editable="false"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
